# Build/serve files
serve.cjs
# ownspace.xpi and update.json are never committed to the tree — they are
# published as GitHub Release assets by CI. Serving them from a release keeps
# git history free of 500KB binaries, and "releases/latest/download/..." is a
# stable URL that always resolves to the newest published version.
ownspace.xpi
update.json
